// Intended architecture. No application implementation exists at scaffold time.
specification {
  element actor
  element component
  element storage
}
model {
  operator = actor 'Shop operator'
  cli = component 'Quote CLI'
  catalog = component 'Catalog reader'
  pricing = component 'Price calculation'
  file = storage 'JSON catalog file'
  operator -> cli 'Provides catalog path, SKU and quantity'
  cli -> catalog 'Loads and validates products'
  catalog -> file 'Reads without modifying'
  cli -> pricing 'Calculates integer cents'
}
views {
  view components {
    title 'Proposed quotation components'
    include *
  }
  dynamic view quoteSuccess {
    title 'Proposed success: C1-C3 / R1-R4'
    variant sequence
    operator -> cli 'Request PEN quantity 3'
    cli -> cli 'Validate arguments and quantity'
    cli -> catalog 'Await catalog load'
    catalog -> file 'Asynchronous file read; catalog remains unchanged'
    file -> catalog 'JSON text'
    catalog -> catalog 'Parse and validate entries and unique SKUs'
    catalog -> cli 'Resolved products'
    cli -> cli 'Find exact-case SKU'
    cli -> pricing 'Synchronous calculation: 1250 cents times 3'
    pricing -> cli '3750 cents'
    cli -> operator 'JSON totalCents 3750'
  }
  dynamic view quoteFailure {
    title 'Proposed invalid catalog: C2-C3 / R2-R3'
    variant sequence
    operator -> cli 'Request quotation'
    cli -> cli 'Validate arguments and quantity'
    cli -> catalog 'Await catalog load'
    catalog -> file 'Asynchronous file read; no writes'
    file -> catalog 'Malformed JSON text'
    catalog -> catalog 'Parsing fails'
    catalog -> cli 'Rejected promise; no pricing call'
    cli -> operator 'Exit 1; stderr only'
  }
}
